<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= ALLOCATE ROOM TO TENANT SECTION ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allocate Room to Tenant"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etAddRoomNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Room Number"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etAddTenantAadhaar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tenant Aadhaar"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etAddStartDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Start Date (DD-MM-YYYY)"
            android:inputType="date"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etAddEndDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="End Date (DD-MM-YYY, Optional)"
            android:inputType="date"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSaveTenancy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Allocation"
            android:layout_marginBottom="24dp" />

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="24dp" />

        <!-- ================= UPDATE TENANCY SECTION ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Tenancy Allocation"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <!-- Search Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etSearchById"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search by Tenancy ID (e.g., 1)"
                android:inputType="number" />

            <Button
                android:id="@+id/btnSearchById"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Edit Form Fields -->
        <EditText
            android:id="@+id/etEditId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tenancy ID"
            android:inputType="number"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEditRoomNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Room Number"
            android:inputType="number"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEditTenantAadhaar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tenant aadhaar"
            android:inputType="number"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEditStartDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Start Date (DD-MM-YYYY)"
            android:inputType="date"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEditEndDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="End Date (DD-MM-YYYY)"
            android:inputType="date"
            android:enabled="false"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnUpdateTenancy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Allocation"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>