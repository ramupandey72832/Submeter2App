<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= ALLOCATE ROOM TO TENANT SECTION ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allocate Room to Tenant"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <!-- Room Number Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room Number"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAddRoomNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter room number"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <!-- Tenant Aadhaar Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tenant Aadhaar"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAddTenantAadhaar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter tenant Aadhaar number"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <!-- Start Date Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Date"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/btnAddStartDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_date_picker"
            android:backgroundTint="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_calendar"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvAddStartDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.App.LabelBody"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="01-01-2026" />
        </LinearLayout>



        <Button
            android:id="@+id/btnSaveTenancy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Allocation"
            android:layout_marginBottom="24dp" />

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="24dp" />

        <!-- ================= UPDATE TENANCY SECTION ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Tenancy Allocation"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <!-- Search Input Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search Tenancy"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <!-- Search Input Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etSearchById"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter Tenancy ID (e.g., 1)"
                android:inputType="number" />

            <Button
                android:id="@+id/btnSearchById"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Edit Form Fields -->

        <!-- Tenancy ID Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tenancy ID"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tenancy ID"
            android:inputType="number"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <!-- Edit Room Number Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room Number"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditRoomNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Room Number"
            android:inputType="number"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <!-- Edit Tenant Aadhaar Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tenant Aadhaar"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditTenantAadhaar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tenant Aadhaar"
            android:inputType="number"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <!-- Update Start Date Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Date"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/btnUpdateStartDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_date_picker"
            android:backgroundTint="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_calendar"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvUpdateStartDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.App.LabelBody"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="01-01-2026" />
        </LinearLayout>

        <!-- Update End Date Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="End Date"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/btnUpdateEndDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_date_picker"
            android:backgroundTint="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_calendar"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvUpdateEndDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.App.LabelBody"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="01-01-2026" />
        </LinearLayout>

        <Button
            android:id="@+id/btnUpdateTenancy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Allocation"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>