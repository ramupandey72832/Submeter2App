<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= ALLOCATE (ADD) SUBMETER SECTION ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allocate Submeter to Room"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <!-- Meter Serial Number Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meter Serial Number"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAddMeterSerialNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter meter serial number"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <!-- Room Number Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room Number"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAddRoomNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter room number"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <!-- Starting Date Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Starting Date"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />


        <LinearLayout
            android:id="@+id/btnAddStartingDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_date_picker"
            android:backgroundTint="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_calendar"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvAddStartingDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.App.LabelBody"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="01-01-2026" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveAllocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Allocation"
            android:layout_marginBottom="24dp" />

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="24dp" />

        <!-- ================= UPDATE EXISTING ALLOCATION SECTION ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Submeter Allocation"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <!-- Search Input Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search Allocation"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <!-- Search Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etSearchById"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search by Allocation ID (e.g., 1)"
                android:inputType="number" />

            <Button
                android:id="@+id/btnSearchById"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Edit Form Fields -->

        <!-- Allocation ID Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allocation ID"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Allocation ID"
            android:inputType="number"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <!-- Meter Number Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meter Number"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditMeterSerialNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Meter Number"
            android:inputType="number"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <!-- Room Number Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room Number"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etEditRoomNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Room Number"
            android:inputType="number"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <!-- Starting Date Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Starting Date"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/btnUpdateStartingDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_date_picker"
            android:backgroundTint="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_calendar"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvUpdateStartingDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.App.LabelBody"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="01-01-2026" />
        </LinearLayout>

        <!-- Ending Date Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ending Date"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/btnUpdateEndingDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_date_picker"
            android:backgroundTint="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_calendar"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvUpdateEndingDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.App.LabelBody"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="01-01-2026" />
        </LinearLayout>

        <Button
            android:id="@+id/btnUpdateAllocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Allocation"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>